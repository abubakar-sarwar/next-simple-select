{
  "name": "next-simple-select",
  "version": "0.1.0",
  "description": "next-simple-select optimized for large datasets",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "tsup",
    "watch": "tsup --watch"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abubakar-sarwar/next-simple-select.git"
  },
  "keywords": [
    "next-simple-select",
    "form",
    "input",
    "select",
    "next",
    "react"
  ],
  "author": "M.Abu Bakar",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/abubakar-sarwar/next-simple-select/issues"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "@types/react": "^19",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tsup": "^9.0.0",
    "typescript": "^5.6.2"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "dependencies": {
    "react-window": "^2.5.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
